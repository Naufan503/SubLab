{
  "name": "sublab",
  "version": "1.0.0",
  "private": true,
  "description": "SubLab: offline Android app that turns audio/video into Whisper transcripts, edits timed captions, and exports to Keyflow (.kf), SRT, VTT, ASS, TTML and more",
  "scripts": {
    "android:add": "cap add android",
    "android:prepare": "node scripts/apply-native.mjs",
    "android:sync": "cap sync android",
    "icons": "capacitor-assets generate --android --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/assets": "^3.0.5"
  }
}
